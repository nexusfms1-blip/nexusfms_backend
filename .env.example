# =================================================================
# Nexus FMS Backend Environment Configuration
# =================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=production

# Remote Railway Database Configuration
DB_HOST=hayabusa.proxy.rlwy.net
DB_PORT=37923
DB_USER=root
DB_PASS=KNDOGiJCCQYRBgHLpYTSnCUWKZUddvHO
DB_NAME=railway

# JWT Authentication
JWT_SECRET=nexus_fms_jwt_secret_key_2026_super_secure
JWT_EXPIRES_IN=7d

# Feature Flags
ENABLE_AUTO_ASSIGNMENT=true

# Webhook Secret (for inbound/outbound verification)
WEBHOOK_SECRET_KEY=nexus_webhook_secure_key_2026

# =================================================================
# 3RD PARTY INTEGRATIONS (Fill these to activate live features)
# =================================================================

# 1. N8N.cloud Webhook Automation
# Create a Webhook trigger node in N8N.cloud and paste the URL below:
N8N_WEBHOOK_URL=https://nexusfms.app.n8n.cloud/webhook/nexus-events
N8N_SMS_WEBHOOK_URL=https://nexusfms.app.n8n.cloud/webhook/send-sms

# 2. OpenAI / Azure AI Configuration
# Option A: Standard OpenAI API Key
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Option B: Azure OpenAI Service (Optional if using Azure)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_KEY=your-azure-openai-api-key

# 3. Live Twilio SMS Gateway (Pay-as-you-go)
# If using Twilio directly for SMS, fill these:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+447700900000
